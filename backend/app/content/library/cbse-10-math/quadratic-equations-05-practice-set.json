      "questionId": "q-quad-ps-1",
      "type": "multiple_choice",
      "prompt": "What is the discriminant of x^2 - 5x + 6 = 0?",
      "options": [
        "1",
        "0",
        "25",
        "49"
      ],
      "conceptIds": [
        "cbse-10-math-quad-discriminant"
      ],
      "difficulty": "introductory",
      "answerKey": 0,
      "hints": [
        "D = (-5)^2 - 4(1)(6) = 25 - 24 = 1."
      ],
      "feedback": "D = 1.",
      "rubric": {
        "math_verification": {
          "domain": "quadratic_equations",
          "subdomain": "discriminant_and_nature",
          "inputs": {
            "a": 1,
            "b": -5,
            "c": 6
          },
          "expected": {
            "discriminant": 1,
            "nature": "two_distinct_real_roots",
            "target_val": "1"
          }
        }
      }
    },
    {
