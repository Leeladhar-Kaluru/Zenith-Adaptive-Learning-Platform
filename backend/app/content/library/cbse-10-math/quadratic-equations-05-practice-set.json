        "0",
        "-6",
        "4"
      ],
      "conceptIds": [
        "cbse-10-math-quad-discriminant"
      ],
      "difficulty": "standard",
      "answerKey": 0,
      "hints": [
        "kx^2 - 2kx + 6 = 0 => D = 4k^2 - 24k = 0 => 4k(k - 6) = 0. Since k != 0, k = 6."
      ],
      "feedback": "k = 6.",
      "rubric": {
        "math_verification": {
          "domain": "quadratic_equations",
          "subdomain": "equal_roots_parameter",
          "inputs": {
            "a": "k",
            "b": "-2*k",
            "c": 6
          },
          "expected": {
            "k_values": [
              0,
              6
            ],
            "target_val": "6"
          }
        }
      }
