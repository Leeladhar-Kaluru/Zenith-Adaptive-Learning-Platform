  "objectives": [
    "State cross-multiplication formula: x/(b1c2 - b2c1) = y/(c1a2 - c2a1) = 1/(a1b2 - a2b1)",
    "Identify parameter values for unique and singular systems"
  ],
  "blocks": [
    {
      "blockId": "lin-crm-blk-1",
      "kind": "definition",
      "heading": "Cross-Multiplication Formula",
      "content": "For $a_1 x + b_1 y + c_1 = 0$ and $a_2 x + b_2 y + c_2 = 0$, when $a_1 b_2 - a_2 b_1 \\ne 0$:\n$$x = \\frac{b_1 c_2 - b_2 c_1}{a_1 b_2 - a_2 b_1}, \\quad y = \\frac{c_1 a_2 - c_2 a_1}{a_1 b_2 - a_2 b_1}$$"
    }
  ],
  "workedExamples": [
    {
      "prompt": "Solve 2x + 3y = 46 and 3x + 5y = 74 by cross-multiplication.",
      "steps": [
        "Step 1: Write as 2x + 3y - 46 = 0 and 3x + 5y - 74 = 0.",
        "Step 2: a1=2, b1=3, c1=-46; a2=3, b2=5, c2=-74.",
        "Step 3: Denominator = a1*b2 - a2*b1 = 2(5) - 3(3) = 10 - 9 = 1.",
        "Step 4: x = (3*(-74) - 5*(-46)) / 1 = (-222 + 230) / 1 = 8.",
        "Step 5: y = (-46*3 - (-74)*2) / 1 = (-138 + 148) / 1 = 10."
      ],
      "answer": "x = 8, y = 10"
    }
  ],
