      "questionId": "q-c6-prac-01",
      "type": "multiple_choice",
      "prompt": "Evaluate: (-13) + (+32) - 8 - 1",
      "options": [
        "10",
        "12",
        "-10",
        "-24"
      ],
      "conceptIds": [
        "cbse-06-math-integers-addition"
      ],
      "difficulty": "standard",
      "answerKey": 0,
      "hints": [
        "Group negatives: (-13) - 8 - 1 = -22.",
        "Then add 32: 32 - 22 = 10."
      ],
      "feedback": "(-13) + 32 - 8 - 1 = 32 - (13 + 8 + 1) = 32 - 22 = 10.",
      "rubric": {
        "math_verification": {
          "domain": "integers",
          "subdomain": "addition",
          "inputs": {
            "expr": "-13 + 32 - 8 - 1"
          },
          "expected": {
            "target_val": "10"
          }
        }
      }
    },
    {
      "questionId": "q-c6-prac-02",
      "type": "multiple_choice",
      "prompt": "The predecessor of -99 is:",
      "options": [
        "-100",
        "-98",
        "98",
        "100"
      ],
      "conceptIds": [
        "cbse-06-math-whole-numbers-predecessor"
      ],
      "difficulty": "standard",
      "answerKey": 0,
      "hints": [
        "Predecessor means subtracting 1: n - 1."
      ],
      "feedback": "Predecessor of -99 = (-99) - 1 = -100.",
      "rubric": {
        "math_verification": {
          "domain": "integers",
          "subdomain": "predecessor",
          "inputs": {
            "n": -99
          },
          "expected": {
            "target_val": "-100"
          }
        }
      }
    },
    {
      "questionId": "q-c6-prac-03",
      "type": "multiple_choice",
      "prompt": "Which integer lies exactly halfway between -6 and +4 on the number line?",
      "options": [
        "-2",
        "-1",
        "0",
        "1"
      ],
      "conceptIds": [
        "cbse-06-math-integers-number-line"
      ],
      "difficulty": "challenge",
      "answerKey": 1,
      "hints": [
        "Midpoint formula is (a + b) / 2."
      ],
      "feedback": "Midpoint = ((-6) + 4) / 2 = -2 / 2 = -1.",
      "rubric": {
        "math_verification": {
          "domain": "integers",
          "subdomain": "midpoint",
          "inputs": {
            "a": -6,
            "b": 4
          },
          "expected": {
            "target_val": "-1"
          }
        }
      }
    }
  ],
  "checkpointTest": [],
  "takeaways": [
    "Predecessor of n is n - 1; for negative numbers, this moves further left (e.g. -99 -> -100).",
    "Midpoint between two numbers a and b is (a + b) / 2."
  ],
