  "objectives": [
    "Apply the quadratic formula: x = (-b +- sqrt(D)) / 2a",
    "Classify roots into two distinct, two equal, or no real roots based on D"
  ],
  "blocks": [
    {
      "blockId": "quad-qf-blk-1",
      "kind": "definition",
      "heading": "The Quadratic Formula",
      "content": "For $ax^2 + bx + c = 0$ ($a \\ne 0$), roots are given by $x = \\frac{-b \\pm \\sqrt{b^2 - 4ac}}{2a}$ provided $b^2 - 4ac \\ge 0$."
    },
    {
      "blockId": "quad-qf-blk-2",
      "kind": "callout",
      "heading": "Discriminant D = b^2 - 4ac",
      "content": "1. $D > 0$: Two distinct real roots.\n2. $D = 0$: Two equal real roots (each $-b/2a$).\n3. $D < 0$: No real roots."
    }
  ],
  "workedExamples": [
    {
      "prompt": "Find the discriminant of 2x^2 - 4x + 3 = 0 and hence find the nature of its roots.",
      "steps": [
        "Step 1: a = 2, b = -4, c = 3.",
        "Step 2: D = b^2 - 4ac = (-4)^2 - 4(2)(3) = 16 - 24 = -8.",
        "Step 3: Since D < 0, the equation has no real roots."
      ],
      "answer": "D = -8, No real roots"
    }
  ],
