      "explanation": "Coefficient of x is 10.",
      "math_verification": {
        "domain": "polynomials",
        "subdomain": "coeff_relations",
        "inputs": {
          "poly": "x**2 + 10*x + 25"
        },
        "expected": {
          "target_val": "-10"
        }
      }
