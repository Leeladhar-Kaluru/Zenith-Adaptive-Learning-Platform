    {
      "questionId": "q-rn-ps-1",
      "type": "multiple_choice",
      "prompt": "What is the HCF of 135 and 225 using prime factorisation?",
      "options": [
        "45",
        "15",
        "25",
        "75"
      ],
      "conceptIds": [
        "cbse-10-math-real-numbers-fta"
      ],
      "difficulty": "introductory",
      "answerKey": 0,
      "hints": [
        "135 = 3^3 * 5, 225 = 3^2 * 5^2.",
        "Common factor is 3^2 * 5 = 45."
      ],
      "feedback": "135 = 3^3 * 5 and 225 = 3^2 * 5^2. HCF = 3^2 * 5 = 45.",
      "rubric": {
        "math_verification": {
          "domain": "real_numbers",
          "subdomain": "hcf_lcm",
          "inputs": {
            "a": 135,
            "b": 225
          },
          "expected": {
            "hcf": 45,
            "target_val": "45"
          }
        }
      }
    },
    {
      "questionId": "q-rn-ps-2",
      "type": "multiple_choice",
      "prompt": "When 210 is divided by 55 according to Euclid's division lemma, what is the remainder?",
      "options": [
        "45",
        "35",
        "25",
        "15"
      ],
      "conceptIds": [
        "cbse-10-math-real-numbers-euclid"
      ],
      "difficulty": "introductory",
      "answerKey": 0,
      "hints": [
        "55 * 3 = 165.",
        "210 - 165 = 45."
      ],
      "feedback": "210 = 55 * 3 + 45. Remainder is 45.",
      "rubric": {
        "math_verification": {
          "domain": "real_numbers",
          "subdomain": "euclid_division",
          "inputs": {
            "a": 210,
            "b": 55
          },
          "expected": {
            "q": 3,
            "r": 45,
            "target_val": "45"
          }
        }
      }
    },
    {
      "questionId": "q-rn-ps-3",
      "type": "multiple_choice",
      "prompt": "What is the prime factorisation of 5005?",
      "options": [
        "5 * 7 * 11 * 13",
        "5 * 7^2 * 13",
        "5 * 11^2 * 7",
        "5^2 * 7 * 11"
      ],
      "conceptIds": [
        "cbse-10-math-real-numbers-fta"
      ],
      "difficulty": "standard",
      "answerKey": 0,
      "hints": [
        "5005 / 5 = 1001.",
        "1001 = 7 * 11 * 13."
      ],
      "feedback": "5005 / 5 = 1001; 1001 / 7 = 143; 143 / 11 = 13. Hence, 5005 = 5 * 7 * 11 * 13.",
      "rubric": {
        "math_verification": {
          "domain": "real_numbers",
          "subdomain": "prime_factorization",
          "inputs": {
            "n": 5005
          },
          "expected": {
            "target_val": "5 * 7 * 11 * 13"
          }
        }
      }
    },
    {
      "questionId": "q-rn-ps-4",
      "type": "multiple_choice",
      "prompt": "What is the decimal expansion characteristic of 77/210?",
      "options": [
        "Non-terminating repeating",
        "Terminating",
        "Terminating after 2 places",
        "Integer"
      ],
      "conceptIds": [
        "cbse-10-math-real-numbers-decimal-expansions"
      ],
      "difficulty": "standard",
      "answerKey": 0,
      "hints": [
        "Simplify: 77/210 = 11/30.",
        "Denominator 30 = 2 * 3 * 5 has prime factor 3."
      ],
      "feedback": "Simplifying gives 11/30. The denominator 30 = 2 * 3 * 5 contains factor 3, making it non-terminating repeating.",
      "rubric": {
        "math_verification": {
          "domain": "real_numbers",
          "subdomain": "terminating_decimal",
          "inputs": {
            "p": 77,
            "q": 210
          },
          "expected": {
            "terminating": false,
            "target_val": "Non-terminating repeating"
          }
        }
      }
    }
  ],
