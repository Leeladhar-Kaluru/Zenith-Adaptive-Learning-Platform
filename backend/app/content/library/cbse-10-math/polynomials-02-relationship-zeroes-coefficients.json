  "blocks": [
    {
      "blockId": "poly-we-blk-1",
      "kind": "definition",
      "heading": "Vieta's Formulas for Quadratics",
      "content": "If $\\alpha$ and $\\beta$ are zeroes of $p(x) = ax^2 + bx + c$ ($a \\ne 0$), then $\\alpha + \\beta = -b/a$ and $\\alpha\\beta = c/a$."
    }
  ],
  "workedExamples": [
    {
      "prompt": "Find the zeroes of 2x^2 - 8x + 6 and verify the relationship with coefficients.",
      "steps": [
        "Step 1: 2x^2 - 8x + 6 = 2(x^2 - 4x + 3) = 2(x - 1)(x - 3).",
        "Step 2: Zeroes are alpha = 1 and beta = 3.",
        "Step 3: Sum of zeroes = 1 + 3 = 4. -b/a = -(-8)/2 = 4. Verified.",
        "Step 4: Product of zeroes = 1 * 3 = 3. c/a = 6/2 = 3. Verified."
      ],
      "answer": "Zeroes: 1, 3; Sum = 4, Product = 3"
    },
    {
      "prompt": "Find a quadratic polynomial whose sum and product of zeroes are 1/4 and -1 respectively.",
      "steps": [
        "Step 1: General form: k[x^2 - (alpha + beta)x + alpha*beta].",
        "Step 2: Substitute: k[x^2 - (1/4)x - 1].",
        "Step 3: Choosing k = 4 gives 4x^2 - x - 4."
      ],
      "answer": "4x^2 - x - 4"
    }
  ],
