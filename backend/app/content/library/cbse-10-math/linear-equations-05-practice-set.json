      "questionId": "q-lin-ps-1",
      "type": "multiple_choice",
      "prompt": "Solve x + y = 10 and x - y = 2.",
      "options": [
        "x = 6, y = 4",
        "x = 5, y = 5",
        "x = 7, y = 3",
        "x = 8, y = 2"
      ],
      "conceptIds": [
        "cbse-10-math-linear-elimination"
      ],
      "difficulty": "introductory",
      "answerKey": 0,
      "hints": [
        "Add equations: 2x = 12 => x = 6."
      ],
      "feedback": "x = 6, y = 4.",
      "rubric": {
        "math_verification": {
          "domain": "linear_equations",
          "subdomain": "unique_solution",
          "inputs": {
            "eq1": "x + y - 10",
            "eq2": "x - y - 2"
          },
          "expected": {
            "solution": [
              "6",
              "4"
            ],
            "target_val": "x = 6, y = 4"
          }
        }
      }
    },
    {
      "questionId": "q-lin-ps-2",
      "type": "multiple_choice",
      "prompt": "What is the consistency nature of 2x - y = 3 and 4x - 2y = 6?",
      "options": [
        "Coincident",
        "Parallel",
        "Intersecting",
        "Perpendicular"
      ],
      "conceptIds": [
        "cbse-10-math-linear-consistency"
      ],
      "difficulty": "introductory",
      "answerKey": 0,
      "hints": [
        "2/4 = -1/(-2) = 3/6 = 1/2."
      ],
      "feedback": "All ratios are equal, so the lines are coincident.",
      "rubric": {
        "math_verification": {
          "domain": "linear_equations",
          "subdomain": "consistency",
          "inputs": {
            "eq1": "2*x - y - 3",
            "eq2": "4*x - 2*y - 6"
          },
          "expected": {
            "target_val": "Coincident"
          }
        }
      }
    },
    {
      "questionId": "q-lin-ps-3",
      "type": "multiple_choice",
      "prompt": "Solve 3x + 2y = 11 and x - y = 2.",
      "options": [
        "x = 3, y = 1",
        "x = 2, y = 2",
        "x = 4, y = 1",
        "x = 1, y = 4"
      ],
      "conceptIds": [
        "cbse-10-math-linear-substitution"
      ],
      "difficulty": "standard",
      "answerKey": 0,
      "hints": [
        "x = y + 2 => 3(y + 2) + 2y = 11 => 5y = 5 => y = 1."
      ],
      "feedback": "y = 1, x = 3.",
      "rubric": {
        "math_verification": {
          "domain": "linear_equations",
          "subdomain": "unique_solution",
          "inputs": {
            "eq1": "3*x + 2*y - 11",
            "eq2": "x - y - 2"
          },
          "expected": {
            "solution": [
              "3",
              "1"
            ],
            "target_val": "x = 3, y = 1"
          }
        }
      }
    },
    {
      "questionId": "q-lin-ps-4",
      "type": "multiple_choice",
      "prompt": "For what value of k is the system x + 2y = 3 and 5x + ky + 7 = 0 parallel?",
      "options": [
        "10",
        "5",
        "2",
        "-10"
      ],
      "conceptIds": [
        "cbse-10-math-linear-consistency"
      ],
      "difficulty": "standard",
      "answerKey": 0,
      "hints": [
        "1/5 = 2/k => k = 10."
      ],
      "feedback": "k = 10 gives parallel lines.",
      "rubric": {
        "math_verification": {
          "domain": "linear_equations",
          "subdomain": "parallel_no_solution_parameter",
          "inputs": {
            "eq1": "x + 2*y - 3",
            "eq2": "5*x + k*y + 7",
            "condition": "no_solution"
          },
          "expected": {
            "k": 10,
            "target_val": "10"
          }
        }
      }
    }
