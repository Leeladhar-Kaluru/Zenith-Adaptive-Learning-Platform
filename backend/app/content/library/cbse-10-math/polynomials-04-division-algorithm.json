  "blocks": [
    {
      "blockId": "poly-div-blk-1",
      "kind": "definition",
      "heading": "Division Algorithm for Polynomials",
      "content": "If $p(x)$ and $g(x)$ are any two polynomials with $g(x) \\ne 0$, then we can find polynomials $q(x)$ and $r(x)$ such that $p(x) = g(x)q(x) + r(x)$, where $r(x) = 0$ or $\\deg r(x) < \\deg g(x)$."
    }
  ],
  "workedExamples": [
    {
      "prompt": "Divide 2x^2 + 3x + 1 by x + 2.",
      "steps": [
        "Step 1: Divide first term: 2x^2 / x = 2x.",
        "Step 2: Multiply: (x + 2)*2x = 2x^2 + 4x.",
        "Step 3: Subtract: (2x^2 + 3x + 1) - (2x^2 + 4x) = -x + 1.",
        "Step 4: Divide: -x / x = -1.",
        "Step 5: Multiply and subtract: -x + 1 - (-x - 2) = 3.",
        "Step 6: Quotient q(x) = 2x - 1, remainder r(x) = 3."
      ],
      "answer": "Quotient = 2x - 1, Remainder = 3"
    }
  ],
