    {
      "questionId": "q-rn-ps-6",
      "type": "multiple_choice",
      "prompt": "If LCM(a, 18) = 36 and HCF(a, 18) = 2, what is the value of a?",
      "options": [
        "4",
        "2",
        "6",
        "8"
      ],
      "conceptIds": [
        "cbse-10-math-real-numbers-fta"
      ],
      "difficulty": "standard",
      "answerKey": 0,
      "hints": [
        "HCF * LCM = a * b => 2 * 36 = a * 18.",
        "72 / 18 = 4."
      ],
      "feedback": "a = (HCF * LCM) / b = (2 * 36) / 18 = 72 / 18 = 4.",
      "rubric": {
        "math_verification": {
          "domain": "real_numbers",
          "subdomain": "hcf_lcm",
          "inputs": {
            "a": 4,
            "b": 18
          },
          "expected": {
            "hcf": 2,
            "lcm": 36,
            "target_val": "4"
          }
        }
      }
    },
