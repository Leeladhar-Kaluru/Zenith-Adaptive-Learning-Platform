        "[-3, 3]",
        "[9, -9]",
        "[3]",
        "[0, 9]"
      ],
      "answerKey": 0,
      "difficulty": "introductory",
      "hints": [
        "x^2 - 9 = (x - 3)(x + 3)."
      ],
      "explanation": "x^2 - 9 = 0 => x = +-3.",
      "math_verification": {
        "domain": "polynomials",
        "subdomain": "quadratic_zeroes",
        "inputs": {
          "poly": "x**2 - 9"
        },
        "expected": {
          "target_val": "[-3, 3]"
        }
      }
