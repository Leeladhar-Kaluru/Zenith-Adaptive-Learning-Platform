  "objectives": [
    "Transform ax^2 + bx + c = 0 into (x + b/2a)^2 = (b^2 - 4ac)/4a^2",
    "Derive the quadratic formula from completing the square"
  ],
  "blocks": [
    {
      "blockId": "quad-cts-blk-1",
      "kind": "summary",
      "heading": "Method of Completing the Square",
      "content": "Divide by $a$: $x^2 + (b/a)x + c/a = 0$. Add and subtract $(b/2a)^2$ to form a perfect square: $(x + b/2a)^2 = (b^2 - 4ac)/4a^2$."
    }
  ],
  "workedExamples": [
    {
      "prompt": "Solve 2x^2 - 5x + 3 = 0 by completing the square.",
      "steps": [
        "Step 1: Divide by 2: x^2 - (5/2)x + 3/2 = 0.",
        "Step 2: Add and subtract (5/4)^2 = 25/16: (x - 5/4)^2 - 25/16 + 3/2 = 0.",
        "Step 3: (x - 5/4)^2 = 25/16 - 24/16 = 1/16.",
        "Step 4: x - 5/4 = +- 1/4 => x = 6/4 = 3/2 or x = 4/4 = 1."
      ],
      "answer": "x = 1, x = 3/2"
    }
  ],
